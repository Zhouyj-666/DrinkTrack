<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>小酌场</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>8</string>

	<!-- FR-HK-06 权限管理：系统授权弹窗展示的文案 -->
	<key>NSHealthShareUsageDescription</key>
	<string>小酌场需要读取你的心率、血氧、HRV 和睡眠数据，用来在饮酒时展示你的实时身体状态，以及生成饮酒日与非饮酒日的长期对比报告。我们只读取数据，不会修改或删除你的健康记录。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>小酌场本版本不会写入任何 Apple 健康数据。</string>

	<!-- FR-DR-05 地点（可选），调用系统定位服务 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>小酌场需要把你导出的饮酒地图或分享卡片保存到相册。</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于在你录入饮酒记录时可选地标注当前地点，并在本机地图上显示你标过的位置。只会在你点「用当前位置」时定位一次，不在后台定位，也不会把精确坐标放到分享卡片或导出的饮酒地图上。</string>

	<!-- Appearance follows the system light/dark setting unless the user picks one in Settings. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreenV2</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
