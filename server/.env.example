# Copy this file to .env and change API_SECRET before the first run.
# Never commit a real .env.

# Used by the API container (the hostname `db` is the Compose service name).
DATABASE_URL=postgresql+psycopg://drinktrack:drinktrack@db:5432/drinktrack

# Pepper used when hashing session tokens. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET=change-me-to-a-long-random-string

# Comma-separated origins, or * for local development.
# iOS clients do not use CORS; this is for a browser hitting the API directly.
CORS_ORIGINS=*

# Opaque session tokens expire after this many days. Logout revokes them sooner.
TOKEN_TTL_DAYS=30
